# ClickUp personal API token (pk_...). Required.
CLICKUP_API_KEY=

# ClickUp workspace (team) id. Required.
CLICKUP_TEAM_ID=

# Access level exposed by the server: read, write or admin.
# CLICKUP_MCP_MODE=write

# Comma separated category filter (navigation, tasks, comments, structure,
# tags, time, docs, daily). Leave unset to enable all categories.
# CLICKUP_ENABLED_CATEGORIES=

# Comma separated explicit tool blocklist.
# CLICKUP_DISABLED_TOOLS=

# IANA timezone used for date resolution.
# CLICKUP_TIMEZONE=<system timezone>

# Tree and list metadata cache TTL, in seconds.
# CLICKUP_CACHE_TTL_SECONDS=300

# Requests per minute, plan dependent.
# CLICKUP_RATE_LIMIT=100

# Character budget per tool response.
# CLICKUP_MAX_RESPONSE_CHARS=40000

# HTTP transport only: port to listen on.
# CLICKUP_HTTP_PORT=3000

# HTTP transport only: host to bind to.
# CLICKUP_HTTP_HOST=127.0.0.1

# HTTP transport only: comma separated list of allowed CORS origins.
# CLICKUP_ALLOWED_ORIGINS=

# stderr logging level: debug, info, warn or error.
# LOG_LEVEL=info
